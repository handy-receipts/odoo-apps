<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Processes orders flagged 'pending' by PosOrder._process_order,
         off the POS checkout critical path. noupdate="1" so a module
         upgrade won't reset the interval if the user has tuned it. -->
    <record id="ir_cron_process_pending_hr_orders" model="ir.cron">
        <field name="name">Handy Receipts: Process Pending Orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_hr_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
